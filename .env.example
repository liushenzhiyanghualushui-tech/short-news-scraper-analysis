# ============================================
# 短新闻爬取与分析系统 - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改
# ⚠️ 重要：.env 文件不应提交到 Git 仓库
# ============================================

# ============================================
# 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=YourSecureRootPassword123!
MYSQL_DATABASE=news_scraper
DB_USERNAME=newsapp
DB_PASSWORD=YourSecureAppPassword456!
DB_HOST=mysql
DB_PORT=3306

# ============================================
# 安全配置
# ============================================
# JWT 密钥（生产环境必须使用强随机密钥，至少 32 字符）
JWT_SECRET=YourSecureJWTSecretKeyAtLeast32Characters!

# FastAPI 内部 API Key（用于 Spring Boot 调用 FastAPI）
FASTAPI_API_KEY=YourSecureInternalAPIKey123!

# ============================================
# Spring Boot 配置
# ============================================
SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx1024m --enable-preview

# ============================================
# FastAPI 配置
# ============================================
FASTAPI_WORKERS=4
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ============================================
# 服务内部通信
# ============================================
FASTAPI_INTERNAL_URL=http://fastapi:8000
SPRING_BOOT_INTERNAL_URL=http://spring-boot:8080

# ============================================
# Hugging Face 配置
# ============================================
HF_ENDPOINT=https://hf-mirror.com
HF_MODEL_ID=bert-base-chinese
HF_TIMEOUT=120
