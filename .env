# ============================================
# 短新闻爬取与分析系统 - 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# ============================================

# ---- MySQL 数据库 ----
MYSQL_ROOT_PASSWORD=123580
MYSQL_DATABASE=news_scraper
MYSQL_USER=newsapp
MYSQL_PASSWORD=newsapp123
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- Spring Boot ----
SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx1024m --enable-preview

# ---- FastAPI ----
FASTAPI_WORKERS=4
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ---- 内部服务通信 ----
FASTAPI_INTERNAL_URL=http://fastapi:8000
SPRING_BOOT_INTERNAL_URL=http://spring-boot:8080

# ---- Hugging Face 镜像 ----
HF_ENDPOINT=https://hf-mirror.com
HF_MODEL_ID=bert-base-chinese
HF_TIMEOUT=120
